+"""CPU/Gloo checks for the actual K2 collective and zero-loss DDP backward."""
+
+import copy
+import os
+import tempfile
+import unittest
+from argparse import Namespace
+from datetime import timedelta
+from pathlib import Path
+
+import torch
+import torch.distributed as dist
+import torch.multiprocessing as mp
+from torch.nn.parallel import DistributedDataParallel
+
+from slime.utils.ppo_early_stop import PPOEarlyStopState, zero_policy_loss
+
+NUM_GPUS = 0
+
+
+def _worker(rank, store):
+    os.environ.setdefault("GLOO_SOCKET_IFNAME", "lo")
+    dist.init_process_group(
+        "gloo", init_method=f"file://{store}", rank=rank, world_size=2,
+        timeout=timedelta(seconds=20),
+    )
+    try:
+        # Unequal token counts: global token mean is .125, not the .25
+        # obtained by incorrectly averaging the two local means.
+        count = 1 if rank == 0 else 3
+        old = torch.zeros(count)
+        mask = torch.ones(count, dtype=torch.bool)
+        state = PPOEarlyStopState(0.13)
+        delta = torch.ones(count) if rank == 0 else torch.zeros(count)
+        assert state.observe(delta, old, mask) == 0.125
+        assert not state.stop_ppo
+
+        # A bad microbatch on just one rank rejects the window on both.
+        delta = torch.full((count,), 2.0) if rank == 1 else torch.zeros(count)
+        assert state.observe(delta, old, mask) == 1.5
+        assert state.stop_ppo and state.first_stopped_microbatch == 2
+        state.observe(old, old, mask)
+        assert state.stop_ppo
+
+        # Local empty masks still enter the collective; masked NaN is ignored.
+        fresh = PPOEarlyStopState(0.13)
+        assert fresh.observe(torch.full_like(old, float("nan")), old, ~mask) == 0
+        assert not fresh.stop_ppo
+        invalid = old.clone()
+        if rank == 0:
+            invalid[0] = float("nan")
+        fresh.observe(invalid, old, mask)
+        assert fresh.stop_ppo and fresh.nonfinite_tokens == 1
+
+        # Exercise DDP gradient collectives, including zero backward after
+        # earlier nonzero accumulation and an already initialized Adam state.
+        model = DistributedDataParallel(torch.nn.Linear(2, 1))
+        optimizer = torch.optim.Adam(model.parameters(), lr=0.01)
+        args = Namespace(use_kl_loss=False)
+        model(torch.ones(1, 2)).square().sum().backward()
+        optimizer.step()
+        optimizer.zero_grad(set_to_none=True)
+        parameters = [p.detach().clone() for p in model.parameters()]
+        adam = copy.deepcopy(optimizer.state_dict())
+        window = PPOEarlyStopState(0.1)
+        for microbatch in range(3):
+            logits = model(torch.ones(count, 2))
+            new = logits[:, 0]
+            delta = torch.full_like(new, 2.0) if microbatch == 1 and rank == 1 else torch.zeros_like(new)
+            window.observe(new, new.detach() - delta, mask)
+            loss = zero_policy_loss(logits, args, {})[0] if window.stop_ppo else logits.square().sum()
+            assert loss.requires_grad and torch.isfinite(loss)
+            loss.backward()
+        assert window.stop_ppo
+        optimizer.zero_grad(set_to_none=True)
+        assert all(torch.equal(p, before) for p, before in zip(model.parameters(), parameters))
+        current = optimizer.state_dict()
+        assert current["param_groups"] == adam["param_groups"]
+        for key, values in adam["state"].items():
+            assert all(torch.equal(current["state"][key][name], value) for name, value in values.items())
+        assert all(p.grad is None for p in model.parameters())
+    finally:
+        dist.destroy_process_group()
+
+
+class DistributedPPOEarlyStopTests(unittest.TestCase):
+    def test_two_rank_token_weighting_latch_and_ddp_backward(self):
+        with tempfile.TemporaryDirectory(prefix="slime-k2-gloo-") as directory:
+            mp.spawn(_worker, args=(str(Path(directory) / "store"),), nprocs=2, join=True)
+
+
+if __name__ == "__main__":
+    unittest.main()
