+"""Action-token K2 guard for a single Megatron PPO optimizer window."""
+
+import math
+from dataclasses import dataclass
+
+import torch
+import torch.distributed as dist
+
+
+def validate_ppo_early_stop_args(args):
+    threshold = getattr(args, "early_stop_kl", 0.0)
+    if not math.isfinite(threshold) or threshold < 0:
+        raise ValueError("--early-stop-kl must be finite and nonnegative (0 disables it).")
+    if threshold == 0:
+        return
+    if getattr(args, "train_backend", "megatron") != "megatron":
+        raise ValueError("--early-stop-kl currently requires the Megatron train backend.")
+    if args.advantage_estimator != "ppo" or args.loss_type != "policy_loss":
+        raise ValueError("--early-stop-kl requires PPO with policy_loss.")
+    # The benchmark has no pipeline/context/tensor parallel loss scheduling.
+    # Do not silently introduce loss collectives into unsupported schedules.
+    if any(getattr(args, key, 1) != 1 for key in (
+        "tensor_model_parallel_size", "pipeline_model_parallel_size", "context_parallel_size",
+    )):
+        raise ValueError("--early-stop-kl currently requires TP=PP=CP=1 (DP and EP are supported).")
+    if any(getattr(args, key, False) for key in (
+        "recompute_loss_function", "enable_mtp_training", "use_tis", "get_mismatch_metrics",
+    )):
+        raise ValueError("--early-stop-kl does not support loss recomputation, MTP, or TIS/mismatch metrics.")
+
+
+def zero_policy_loss(logits, args, batch):
+    # An empty view retains the complete model's backward graph without
+    # reading logits or multiplying an existing NaN/Inf loss by zero.
+    loss = logits.reshape(-1)[:0].float().sum()
+    names = ["loss", "pg_loss", "entropy_loss", "pg_clipfrac", "ppo_kl"]
+    if batch.get("rollout_log_probs"):
+        names.append("train_rollout_logprob_abs_diff")
+    if args.use_kl_loss:
+        names.append("kl_loss")
+    if getattr(args, "use_opsm", False):
+        names.append("opsm_clipfrac")
+    if "opd_reverse_kl" in batch:
+        names.append("opd_reverse_kl")
+    return loss, {name: loss.detach() for name in names}
+
+
+@dataclass
+class PPOEarlyStopState:
+    threshold: float
+    stop_ppo: bool = False
+    squared_sum: float = 0.0
+    token_count: int = 0
+    max_microbatch_kl: float = 0.0
+    microbatches: int = 0
+    first_stopped_microbatch: int = 0
+    nonfinite_tokens: int = 0
+
+    @torch.no_grad()
+    def observe(self, new_log_probs, old_log_probs, mask, group=None):
+        if new_log_probs.shape != old_log_probs.shape or new_log_probs.shape != mask.shape:
+            raise ValueError("K2 logprobs and action-token mask must have the same shape.")
+        keep = mask.to(device=new_log_probs.device, dtype=torch.bool)
+        # Select before subtraction/squaring, so masked NaN/Inf cannot pollute
+        # the statistic. FP64 also avoids overflow in finite FP32 differences.
+        delta = new_log_probs.detach()[keep].double() - old_log_probs.detach()[keep].double()
+        finite = torch.isfinite(delta)
+        stats = torch.stack((
+            0.5 * delta[finite].square().sum(),
+            delta.new_tensor(delta.numel()),
+            (~finite).double().sum(),
+        ))
+        if dist.is_initialized():
+            dist.all_reduce(stats, op=dist.ReduceOp.SUM, group=group)
+        squared_sum, count, bad_count = stats.tolist()
+        if bad_count or not math.isfinite(squared_sum):
+            squared_sum = math.inf
+        k2 = squared_sum / max(count, 1)
+        self.microbatches += 1
+        self.squared_sum += squared_sum
+        self.token_count += int(count)
+        self.nonfinite_tokens += int(bad_count)
+        self.max_microbatch_kl = max(self.max_microbatch_kl, k2)
+        if not math.isfinite(k2) or k2 > self.threshold:
+            if not self.stop_ppo:
+                self.first_stopped_microbatch = self.microbatches
+            self.stop_ppo = True
+        return k2
+
+    def metrics(self):
+        # All microbatches are observed, including those after the latch, so
+        # this is the whole window's token-weighted mean, not a prefix mean.
+        return {
+            "k2_kl": self.squared_sum / max(self.token_count, 1),
+            "k2_kl_max_microbatch": self.max_microbatch_kl,
+            "early_stop": float(self.stop_ppo),
+            "early_stop_microbatch": self.first_stopped_microbatch,
+            "early_stop_nonfinite_tokens": self.nonfinite_tokens,
+            "optimizer_step_skipped": float(self.stop_ppo),
+        }
